  m_TableData:
  - m_Id: 8033288192
    m_Localized: "C\xE1 m\u1EADp l\xE0 nh\u1EEFng lo\xE0i c\xE1 s\u0103n m\u1ED3i
      m\u1EA1nh m\u1EBD, n\u1ED5i ti\u1EBFng v\u1EDBi b\u1ED9 h\xE0m s\u1EAFc b\xE9n
      v\xE0 kh\u1EA3 n\u0103ng th\xEDch nghi tuy\u1EC7t v\u1EDDi trong m\xF4i tr\u01B0\u1EDDng
      bi\u1EC3n. Ch\xFAng \u0111\xF3ng vai tr\xF2 quan tr\u1ECDng trong vi\u1EC7c
      duy tr\xEC s\u1EF1 c\xE2n b\u1EB1ng c\u1EE7a h\u1EC7 sinh th\xE1i \u0111\u1EA1i
      d\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 4717666254848
    m_Localized: "C\u1EA7n c\xE2u l\xE0 m\u1ED9t c\xF4ng c\u1EE5 thi\u1EBFt y\u1EBFu,
      gi\xFAp ng\u01B0\u1EDDi c\xE2u c\xE1 v\u01B0\u01A1n xa v\xE0 ki\u1EC3m so\xE1t
      con m\u1ED3i m\u1ED9t c\xE1ch hi\u1EC7u qu\u1EA3."
    m_Metadata:
      m_Items: []
  - m_Id: 398125425516544
    m_Localized: "\u0110\xE2y l\xE0 h\u1EA1t gi\u1ED1ng c\xE0 chua"
    m_Metadata:
      m_Items: []
