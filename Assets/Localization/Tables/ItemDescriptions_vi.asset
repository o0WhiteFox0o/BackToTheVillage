  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ItemDescriptions_vi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 95ab3aa9c95b5c2448881d7d9476e40c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8033288192
    m_Localized: "C\xE1 m\u1EADp l\xE0 nh\u1EEFng lo\xE0i c\xE1 s\u0103n m\u1ED3i
      m\u1EA1nh m\u1EBD, n\u1ED5i ti\u1EBFng v\u1EDBi b\u1ED9 h\xE0m s\u1EAFc b\xE9n
      v\xE0 kh\u1EA3 n\u0103ng th\xEDch nghi tuy\u1EC7t v\u1EDDi trong m\xF4i tr\u01B0\u1EDDng
      bi\u1EC3n. Ch\xFAng \u0111\xF3ng vai tr\xF2 quan tr\u1ECDng trong vi\u1EC7c
      duy tr\xEC s\u1EF1 c\xE2n b\u1EB1ng c\u1EE7a h\u1EC7 sinh th\xE1i \u0111\u1EA1i
      d\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 4717666254848
    m_Localized: "C\u1EA7n c\xE2u l\xE0 m\u1ED9t c\xF4ng c\u1EE5 thi\u1EBFt y\u1EBFu,
      gi\xFAp ng\u01B0\u1EDDi c\xE2u c\xE1 v\u01B0\u01A1n xa v\xE0 ki\u1EC3m so\xE1t
      con m\u1ED3i m\u1ED9t c\xE1ch hi\u1EC7u qu\u1EA3."
    m_Metadata:
      m_Items: []
  - m_Id: 364042154217472
    m_Localized: "L\xE0 con giun \u0111\u01B0\u1EE3c \u0111\xE0o t\u1EEB \u0111\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 2532333300367360
    m_Localized: "C\xE1 m\xE8 l\xE0 m\u1ED9t lo\xE0i c\xE1 n\u01B0\u1EDBc ng\u1ECDt
      c\xF3 th\xE2n h\xECnh d\u1EB9t b\xEAn, v\u1EA3y nh\u1ECF, v\xE0 ph\u1EA7n \u0111\u1EA7u
      l\u1EDBn so v\u1EDBi c\u01A1 th\u1EC3."
    m_Metadata:
      m_Items: []
  - m_Id: 2537154115944448
    m_Localized: "C\xE1 ch\xE9p l\xE0 lo\xE0i c\xE1 n\u01B0\u1EDBc ng\u1ECDt quen
      thu\u1ED9c, c\xF3 th\xE2n h\xECnh b\u1EA7u d\u1EE5c, v\xE2y l\u01B0ng d\xE0i,
      r\xE2u m\xE9p n\u1ED5i b\u1EADt v\xE0 l\xE0 bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a
      s\u1EF1 may m\u1EAFn."
    m_Metadata:
      m_Items: []
  - m_Id: 2537180233875456
    m_Localized: "C\xE1 tr\xEA \u0111\u01B0\u1EE3c nh\u1EADn bi\u1EBFt d\u1EC5 d\xE0ng
      qua \u0111\u1EA7u d\u1EB9p, da tr\u01A1n l\xE1ng kh\xF4ng v\u1EA3y, v\xE0 b\u1ED9
      r\xE2u d\xE0i nh\u01B0 ria m\xE9p, ch\xFAng l\xE0 lo\xE0i \u0103n t\u1EA1p
      v\xE0 s\u1ED1ng ch\u1EE7 y\u1EBFu \u1EDF t\u1EA7ng \u0111\xE1y b\xF9n."
    m_Metadata:
      m_Items: []
  - m_Id: 2537207194861568
    m_Localized: "\u1EBEch l\xE0 lo\xE0i l\u01B0\u1EE1ng c\u01B0 c\xF3 da tr\u01A1n
      v\xE0 \u1EA9m \u01B0\u1EDBt, n\u1ED5i b\u1EADt v\u1EDBi \u0111\xF4i ch\xE2n
      sau d\xE0i v\xE0 kh\u1ECFe gi\xFAp ch\xFAng nh\u1EA3y xa, th\u01B0\u1EDDng
      \u0111\u01B0\u1EE3c nu\xF4i ho\u1EB7c s\u0103n b\u1EAFt l\xE0m th\u1EF1c ph\u1EA9m."
    m_Metadata:
      m_Items: []
  - m_Id: 2537237809086464
    m_Localized: "C\xE1 b\u1ED1ng l\xE0 nh\xF3m c\xE1 nh\u1ECF \u0111a d\u1EA1ng,
      \u0111\u1EB7c tr\u01B0ng b\u1EDFi hai v\xE2y b\u1EE5ng d\xEDnh l\u1EA1i th\xE0nh
      gi\xE1c h\xFAt gi\xFAp ch\xFAng b\xE1m v\xE0o \u0111\xE1y s\xF4ng ho\u1EB7c
      \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 2537275138392064
    m_Localized: "C\xE1 s\u1EB7c l\xE0 lo\xE0i c\xE1 c\xF3 th\xE2n h\xECnh d\u1EB9t,
      v\xE2y b\u1EE5ng d\xE0i v\xE0 m\u1EA3nh nh\u01B0 s\u1EE3i ch\u1EC9, ch\xFAng
      c\xF3 c\u01A1 quan h\xF4 h\u1EA5p ph\u1EE5 gi\xFAp ch\xFAng t\u1ED3n t\u1EA1i
      trong m\xF4i tr\u01B0\u1EDDng n\u01B0\u1EDBc thi\u1EBFu oxy."
    m_Metadata:
      m_Items: []
  - m_Id: 2537328028565504
    m_Localized: "T\xF4m c\xE0ng xanh l\xE0 lo\xE0i gi\xE1p x\xE1c n\u01B0\u1EDBc
      ng\u1ECDt c\xF3 gi\xE1 tr\u1ECB kinh t\u1EBF cao, n\u1ED5i b\u1EADt v\u1EDBi
      hai c\xE0ng tr\u01B0\u1EDBc r\u1EA5t d\xE0i v\xE0 l\u1EDBn, c\xF3 m\xE0u xanh
      lam, \u0111\u1EB7c bi\u1EC7t l\xE0 \u1EDF con \u0111\u1EF1c."
    m_Metadata:
      m_Items: []
  - m_Id: 2537371779350528
    m_Localized: "C\xE1 linh l\xE0 lo\xE0i c\xE1 nh\u1ECF, th\xE2n d\u1EB9t, m\xE0u
      b\u1EA1c l\u1EA5p l\xE1nh, xu\u1EA5t hi\u1EC7n r\u1ED9 nh\u1EA5t v\xE0o m\xF9a
      n\u01B0\u1EDBc n\u1ED5i \u1EDF \u0110\u1ED3ng b\u1EB1ng s\xF4ng C\u1EEDu Long,
      l\xE0 \u0111\u1EB7c s\u1EA3n theo m\xF9a d\xF9ng \u0111\u1EC3 n\u1EA5u l\u1EA9u
      m\u1EAFm ho\u1EB7c l\xE0m m\u1EAFm."
    m_Metadata:
      m_Items: []
  - m_Id: 2537421641236480
    m_Localized: "C\xE1 ch\u1ED1t l\xE0 lo\xE0i c\xE1 da tr\u01A1n c\u1EE1 nh\u1ECF,
      c\xF3 v\xE2y l\u01B0ng v\xE0 v\xE2y ng\u1EF1c s\u1EAFc nh\u1ECDn nh\u01B0 ng\u1EA1nh,
      ch\xFAng s\u1ED1ng \u1EDF t\u1EA7ng \u0111\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 2537465933086720
    m_Localized: "C\xE1 r\xF4 l\xE0 lo\xE0i c\xE1 c\xF3 th\xE2n h\xECnh b\u1EA7u
      d\u1EE5c, h\u01A1i d\u1EB9t hai b\xEAn, v\u1EA3y c\u1EE9ng v\xE0 \u0111\u1EB7c
      tr\u01B0ng l\xE0 mang c\xF3 gai s\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 2537502184456192
    m_Localized: "C\xE1 l\xF2ng tong l\xE0 nh\xF3m c\xE1 nh\u1ECF, th\xE2n thon d\xE0i,
      v\u1EA3y \xF3ng \xE1nh, th\u01B0\u1EDDng b\u01A1i th\xE0nh \u0111\xE0n \u0111\xF4ng
      \u0111\xFAc tr\xEAn m\u1EB7t n\u01B0\u1EDBc ho\u1EB7c t\u1EA7ng gi\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 2537577220554752
    m_Localized: "R\u1EAFn l\xE0 lo\xE0i b\xF2 s\xE1t kh\xF4ng ch\xE2n c\xF3 c\u01A1
      th\u1EC3 ph\u1EE7 v\u1EA3y, n\u1ED5i b\u1EADt v\u1EDBi kh\u1EA3 n\u0103ng di
      chuy\u1EC3n linh ho\u1EA1t v\xE0 l\u1ED9t da."
    m_Metadata:
      m_Items: []
  - m_Id: 2537607591510016
    m_Localized: "C\xE1 l\xF3c l\xE0 lo\xE0i c\xE1 s\u0103n m\u1ED3i n\u01B0\u1EDBc
      ng\u1ECDt, c\xF3 th\xE2n h\xECnh tr\u1EE5 tr\xF2n, \u0111\u1EA7u d\u1EB9t gi\u1ED1ng
      \u0111\u1EA7u r\u1EAFn v\xE0 kh\u1EA3 n\u0103ng s\u1ED1ng s\xF3t trong b\xF9n
      l\u1EA7y."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
