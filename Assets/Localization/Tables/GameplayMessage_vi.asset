  m_TableData:
  - m_Id: 7509000192
    m_Localized: "V\u1EADt ph\u1EA9m n\xE0y kh\xF4ng th\u1EC3 b\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2165486843478016
    m_Localized: "Nhi\u1EC7m v\u1EE5 ch\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 2165644100517888
    m_Localized: "Nhi\u1EC7m v\u1EE5 s\u1EF1 ki\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 2165786467778560
    m_Localized: "Nhi\u1EC7m v\u1EE5 \u0111\u1ED3ng h\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 2165954567094272
    m_Localized: "Nhi\u1EC7m v\u1EE5 kh\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 2167867442348032
    m_Localized: "Kh\xF4ng c\xF3 nhi\u1EC7m v\u1EE5 n\xE0o trong ph\xE2n lo\u1EA1i
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 2168980170227712
    m_Localized: "Nh\xE2n v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 2169076324646912
    m_Localized: "Nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2169218696101888
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 4339721900802048
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 4695001071239168
    m_Localized: "B\u1EA1n v\u1EEBa ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5 "
    m_Metadata:
      m_Items: []
  - m_Id: 6502139569520640
    m_Localized: "Nh\u1EA1c n\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6502143520555008
    m_Localized: "Hi\u1EC7u \u1EE9ng \xE2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 5433503630561280
    m_Localized: "N\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 5433599340384256
    m_Localized: "N\u1EA5u Nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 5441124173418496
    m_Localized: "Th\xE0nh Th\u1EA1o:"
    m_Metadata:
      m_Items: []
